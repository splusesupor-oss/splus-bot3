# فایل نمونه - آن را کپی کنید به .env و مقادیر را پر کنید
# cp .env.example .env

# ========= حالت یوزر-بات (پیشنهادی برای مدیریت گروه) =========
# SESSION_STRING را بعد از اولین اجرای main.py دریافت می‌کنید
SOROUSH_SESSION_STRING=
# اگر کلید API شخصی دارید (اختیاری، SPlusthon کلید پیش‌فرض دارد)
API_ID=
API_HASH=

# ========= حالت ربات رسمی (جایگزین) =========
# توکن ربات که از @MrBot در سروش پلاس می‌گیرید
BOT_TOKEN=
SOROUSH_BOT_TOKEN=

# ========= تنظیمات اضافی =========
# آیدی گروه‌های هدف (اختیاری، خالی = همه گروه‌ها)
# TARGET_GROUPS=-100123456789,-100987654321

# ========= بودجه اتصال مشترک SPlusthon =========
# پیش‌فرض امن و فعال: از انباشته شدن RPC چند گروه روی یک WebSocket جلوگیری می‌کند.
BOT_RPC_GOVERNOR_ENABLED=1
# برای مشاهده معیارها بدون محدودسازی موقتاً 1 کنید؛ برای حالت عادی 0 بماند.
BOT_RPC_GOVERNOR_SHADOW=0
# مقادیر پیشنهادی اولیه؛ فقط پس از مشاهده لاگ واقعی تغییر دهید.
# یک WebSocket سروش با RPC همزمان زیاد timeout می‌شود؛ این سقف‌ها عمداً محافظه‌کارانه‌اند.
BOT_RPC_TOTAL_LIMIT=3
BOT_RPC_NONCRITICAL_LIMIT=2
BOT_RPC_DELETE_LIMIT=1
BOT_RPC_SEND_LIMIT=2
BOT_RPC_HEAVY_LIMIT=1

# ========= تأخیر صف‌های هر گروه =========
# حداکثر سه مجازاتِ کاربران متفاوت یک گروه هم‌زمان اجرا می‌شود؛
# عملیات یک کاربر همچنان سریال است. بازه مجاز کد: 1 تا 3.
BOT_MODERATION_PER_CHAT_LIMIT=3
# workerهای پیام عادی هر گروه؛ برای جذب burst بدون معطل‌کردن چندثانیه‌ای.
# کد مقدار را در بازه 1 تا 8 محدود می‌کند؛ پیش‌فرض 6 است.
BOT_NORMAL_WORKERS_PER_CHAT=6
# دو ارسال عادی مستقل همان گروه از دو slot موجود استفاده می‌کنند؛ اعلان‌های
# مدیریتی priority=0 صف جدا دارند. بازه مجاز کد: 1 تا 2.
BOT_SEND_NORMAL_WORKERS_PER_CHAT=1
# سقف کل پاسخ‌های عادی/بازی در انتظار؛ هنگام شلوغی drop می‌شوند تا اتصال فریز نشود.
BOT_SEND_GLOBAL_NORMAL_PENDING=40
# بیش از این تعداد send منتظر در governor حذف می‌شود تا فرمان مدیریتی عقب نیفتد.
BOT_RPC_MAX_SEND_WAITERS=0

# ========= ناظر دائمی Crash =========
# تأخیر restart اول و سقف backoff برای crashهای پیاپی (ثانیه)
WATCHDOG_RESTART_DELAY=5
WATCHDOG_MAX_RESTART_DELAY=60
# پس از این مدت اجرای سالم، شمارنده crashهای پیاپی صفر می‌شود.
WATCHDOG_STABLE_SECONDS=300
# یک خطای یکسان در این بازه فقط یک بار به مالک گزارش می‌شود.
WATCHDOG_REPORT_COOLDOWN=900
# اگر ربات سه بار پیش از کامل شدن startup بمیرد، Watchdog در فاصله‌ای که
# child خاموش است با همان session گزارش «نیاز به بررسی دارد» را می‌فرستد.
WATCHDOG_RAPID_FAILURE_WINDOW=20
WATCHDOG_RAPID_FAILURE_LIMIT=3
# سقف هر پیام پیوی و مقدار Traceback داخل پیام؛ نسخه کامل همیشه در logs است.
WATCHDOG_OWNER_MESSAGE_LIMIT=3500
WATCHDOG_OWNER_TRACEBACK_MAX_CHARS=12000
# چرخش لاگ خود Watchdog
WATCHDOG_LOG_MAX_BYTES=2097152
WATCHDOG_LOG_BACKUPS=5

# ========= گزارش کندی زنده (بدون spam لاگ) =========
# رویدادهای بالای 150ms فقط در حافظه تجمیع می‌شوند؛ برای هر رویداد لاگ ترمینال نداریم.
# کندی شدید حداکثر هر 30 ثانیه یک پیام خصوصی مالک می‌فرستد.
WATCHDOG_SLOW_ALERT_THRESHOLD_MS=1000
WATCHDOG_SLOW_ALERT_INTERVAL_SECONDS=30
# هر پنج دقیقه یک گزارش تجمیعی از تمام مسیرهای کند ارسال می‌شود.
WATCHDOG_SLOW_BATCH_INTERVAL_SECONDS=300
# در فشار اتصال، گزارش ارسال نمی‌شود و دادهٔ تجمیعی برای دور بعد نگه داشته می‌شود.
WATCHDOG_SLOW_RPC_PRESSURE_LIMIT=8
WATCHDOG_SLOW_QUEUE_SIZE=2
