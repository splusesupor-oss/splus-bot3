++def write_crash_report(report_text: str, info: dict, output_text: str) -> Path:
++    """ذخیرهٔ گزارش کامل (قالب + Traceback) و ثبتِ JSONL، با هرسِ قدیمی‌ها."""
++    reports_dir = Path(LOG_DIR) / "crash_reports"
++    reports_dir.mkdir(parents=True, exist_ok=True)
++    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
++    report_path = reports_dir / f"crash_{stamp}.log"
++    payload = report_text
++    if info.get("traceback"):
++        payload += "\n\n--- Traceback کامل ---\n" + info["traceback"]
++    elif output_text:
++        tail = "\n".join(output_text.splitlines()[-60:])
++        payload += "\n\n--- انتهای خروجی فرایند ---\n" + tail
++    try:
++        report_path.write_text(payload, encoding="utf-8")
++    except OSError:
++        pass
++
++    jsonl_path = Path(LOG_DIR) / "watchdog_reports.jsonl"
++    record = {
++        "timestamp": _now_text(),
++        "error_type": info.get("error_type"),
++        "file": info.get("file"),
++        "line": info.get("line"),
++        "summary": info.get("summary"),
++    }
++    try:
++        with jsonl_path.open("a", encoding="utf-8") as stream:
++            stream.write(json.dumps(record, ensure_ascii=False) + "\n")
++    except OSError:
++        pass
++
++    _prune_crash_reports(reports_dir)
++    return report_path
++
++
++def _prune_crash_reports(reports_dir: Path, keep: int = _CRASH_REPORT_KEEP) -> None:
++    try:
++        files = sorted(
++            reports_dir.glob("crash_*.log"),
++            key=lambda path: path.stat().st_mtime,
++        )
++    except OSError:
++        return
++    for old in files[:-max(1, keep)]:
++        try:
++            old.unlink()
++        except OSError:
++            pass
++
