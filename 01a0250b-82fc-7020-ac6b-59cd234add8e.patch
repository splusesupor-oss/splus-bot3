new file mode 100644
index 0000000..7731c37
--- /dev/null
+++ b/tests/test_watchdog.py
@@ -0,0 +1,164 @@
+# -*- coding: utf-8 -*-
+"""تست‌های Watchdog — بدون نیاز به اتصال به سروش.
+
+اجرا:
+    python3 -m unittest tests.test_watchdog
+یا مستقیم:
+    python3 tests/test_watchdog.py
+"""
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+import watchdog  # noqa: E402
+from watchdog import (  # noqa: E402
+    build_report,
+    classify_exit,
+    extract_traceback,
+    Watchdog,
+)
+from modules.owner_check import get_owner  # noqa: E402
+
+
+SAMPLE_TRACEBACK = """\
+Traceback (most recent call last):
+  File "/app/main.py", line 7, in <module>
+    asyncio.run(main())
+  File "/usr/lib/python3.11/asyncio/runners.py", line 190, in run
+    return runner.run(main)
+  File "/app/core/bot_working_split_ok.py", line 2104, in run
+    await handle_new_message(self, event)
+RuntimeError: connection lost
+"""
+
+
+class ExtractTracebackTests(unittest.TestCase):
+    def test_extracts_file_line_type_summary(self):
+        info = extract_traceback(SAMPLE_TRACEBACK)
+        self.assertIsNotNone(info)
+        self.assertEqual(info["error_type"], "RuntimeError")
+        self.assertEqual(info["file"], "/app/core/bot_working_split_ok.py")
+        self.assertEqual(info["line"], "2104")
+        self.assertEqual(info["summary"], "connection lost")
+        self.assertIn("Traceback (most recent call last):", info["traceback"])
+
+    def test_error_without_message(self):
+        info = extract_traceback(
+            "Traceback (most recent call last):\n"
+            '  File "a.py", line 3, in f\n'
+            "KeyboardInterrupt\n"
+        )
+        self.assertIsNotNone(info)
+        self.assertEqual(info["error_type"], "KeyboardInterrupt")
+
+    def test_no_traceback_returns_none(self):
+        self.assertIsNone(extract_traceback(""))
+        self.assertIsNone(extract_traceback("just some log lines\nno crash here\n"))
+
+    def test_chained_traceback_uses_last(self):
+        text = (
+            "Traceback (most recent call last):\n"
+            '  File "x.py", line 1, in a\n'
+            "ValueError: first\n"
+            "\n"
+            "The above exception was the direct cause of:\n"
+            "\n"
+            "Traceback (most recent call last):\n"
+            '  File "y.py", line 9, in b\n'
+            "RuntimeError: final cause\n"
+        )
+        info = extract_traceback(text)
+        self.assertEqual(info["error_type"], "RuntimeError")
+        self.assertEqual(info["file"], "y.py")
+        self.assertEqual(info["line"], "9")
+
+
+class ClassifyExitTests(unittest.TestCase):
+    def test_crash_reports(self):
+        result = classify_exit(1, SAMPLE_TRACEBACK, uptime_s=120, shutdown_requested=False)
+        self.assertTrue(result["report"])
+        self.assertEqual(result["kind"], "crash")
+        self.assertEqual(result["info"]["error_type"], "RuntimeError")
+
+    def test_abnormal_stop_reports(self):
+        result = classify_exit(137, "no traceback", uptime_s=120, shutdown_requested=False)
+        self.assertTrue(result["report"])
+        self.assertEqual(result["kind"], "abnormal_stop")
+
+    def test_normal_stop_no_report(self):
+        result = classify_exit(0, "bye", uptime_s=1000, shutdown_requested=False)
+        self.assertFalse(result["report"])
+        self.assertEqual(result["kind"], "normal_stop")
+
+    def test_early_stop_reports(self):
+        result = classify_exit(0, "", uptime_s=5, shutdown_requested=False)
+        self.assertTrue(result["report"])
+        self.assertEqual(result["kind"], "early_stop")
+
+    def test_shutdown_no_report(self):
+        result = classify_exit(1, SAMPLE_TRACEBACK, uptime_s=5, shutdown_requested=True)
+        self.assertFalse(result["report"])
+        self.assertEqual(result["kind"], "shutdown")
+
+
+class ReportFormatTests(unittest.TestCase):
+    def test_template_fields(self):
+        text = build_report(
+            {
+                "error_type": "RuntimeError",
+                "file": "core/bot.py",
+                "line": "42",
+                "summary": "boom",
+            },
+            "ربات دوباره راه‌اندازی شد",
+            timestamp="2026-08-21 16:20:00",
+        )
+        for expected in (
+            "🚨 خطای ربات",
+            "زمان:", "2026-08-21 16:20:00",
+            "نوع خطا:", "RuntimeError",
+            "فایل:", "core/bot.py",
+            "خط:", "42",
+            "جزئیات:", "boom",
+            "وضعیت:", "ربات دوباره راه‌اندازی شد",
+        ):
+            self.assertIn(expected, text)
+
+    def test_needs_investigation_status(self):
+        text = build_report(
+            {"error_type": "ExitCode(1)", "file": "نامشخص", "line": "—",
+             "summary": "x"},
+            "نیاز به بررسی دارد",
+        )
+        self.assertIn("نیاز به بررسی دارد", text)
+
+
+class OwnerOnlyReportTests(unittest.TestCase):
+    def test_report_goes_only_to_owner(self):
+        received = []
+
+        def fake_notifier(owner_id, text):
+            received.append((owner_id, text))
+            return True
+
+        crash_cmd = [
+            sys.executable, "-c",
+            "raise RuntimeError('watchdog owner-only test')",
+        ]
+        summary = Watchdog(crash_cmd, notifier=fake_notifier).run_once()
+        owner_id = int(get_owner()["user_id"])
+
+        self.assertTrue(summary["report_worthy"])
+        self.assertEqual(summary["recipient"], owner_id)
+        self.assertEqual(len(received), 1)
+        self.assertEqual(received[0][0], owner_id)
+        self.assertIn("🚨 خطای ربات", received[0][1])
+        self.assertIn("RuntimeError", received[0][1])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
