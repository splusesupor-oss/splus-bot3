++# ناظر اصلی
++# ---------------------------------------------------------------------------
++class Watchdog:
++    """اجرا و نظارتِ دائمی روی فرایند ربات."""
++
++    def __init__(self, cmd, *, notifier=None):
++        self.cmd = list(cmd)
++        self.notifier = notifier or default_notifier
++        self._stop_requested = False
++        self._current_proc = None
++        self._consecutive = 0
++        self._last_report_at = None
++        self._child_log = _RotatingLog(runtime_log_file("watchdog_child.log"))
++        self._own_log = _RotatingLog(runtime_log_file("watchdog.log"))
++
++    # -- لاگ ناظر ----------------------------------------------------------
++    def _log(self, message: str) -> None:
++        line = f"[{_now_text()}] {message}\n"
++        print(line.rstrip("\n"))
++        self._own_log.write(line)
++
++    # -- مدیریت سیگنال‌ها ---------------------------------------------------
++    def _install_signals(self) -> None:
++        def _handler(_signum, _frame):
++            self._stop_requested = True
++            self._log("WATCHDOG stop signal received")
++            self._terminate_current()
++
++        for signame in ("SIGINT", "SIGTERM"):
++            try:
++                signal.signal(getattr(signal, signame), _handler)
++            except (ValueError, OSError, AttributeError):
++                pass
++
++    def _terminate_current(self) -> None:
++        proc = self._current_proc
++        if proc is None or proc.poll() is not None:
++            return
++        try:
++            os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
++        except (ProcessLookupError, PermissionError, OSError):
++            try:
++                proc.terminate()
++            except OSError:
++                pass
++
++    # -- اجرای یک چرخهٔ نظارت ----------------------------------------------
++    def _spawn(self):
++        env = os.environ.copy()
++        env.setdefault("PYTHONUNBUFFERED", "1")
++        return subprocess.Popen(
++            self.cmd,
++            stdout=subprocess.PIPE,
++            stderr=subprocess.STDOUT,
++            text=True,
++            encoding="utf-8",
++            errors="replace",
++            bufsize=1,
++            cwd=str(_PROJECT_ROOT),
++            env=env,
++            start_new_session=True,
++        )
++
++    @staticmethod
++    def _pump(proc, ring: _RingBuffer, writer: _RotatingLog) -> None:
++        try:
++            stream = proc.stdout
++            if stream is None:
++                return
++            for line in stream:
++                ring.append(line)
++                writer.write(line)
++        except Exception:
++            pass
++
++    def run_once(self) -> dict:
++        """یک چرخهٔ کامل: اجرا → انتظار → تشخیص → گزارش → آماده‌سازی ری‌استارت."""
++        started = time.monotonic()
++        self._log(f"WATCHDOG start child: {' '.join(self.cmd)}")
++        try:
++            proc = self._spawn()
++        except Exception as error:
++            self._log(f"WATCHDOG spawn failed: {error!r}")
++            return {
++                "kind": "spawn_failed", "report_worthy": False,
++                "report_sent": False, "recipient": None,
++                "report_text": None, "status": None, "info": {},
++                "delay": _RESTART_DELAY, "consecutive": self._consecutive,
++            }
++        self._current_proc = proc
++
++        ring = _RingBuffer(_OUTPUT_LINES)
++        reader = threading.Thread(
++            target=self._pump, args=(proc, ring, self._child_log), daemon=True
++        )
++        reader.start()
++
++        code = proc.wait()
++        reader.join(timeout=5)
++        self._current_proc = None
++
++        uptime = time.monotonic() - started
++        output = ring.text()
++        result = classify_exit(code, output, uptime, self._stop_requested)
++        kind = result["kind"]
++        info = result["info"]
++        report_worthy = bool(result["report"])
++
++        summary = {
++            "kind": kind,
++            "report_worthy": report_worthy,
++            "report_sent": False,
++            "recipient": None,
++            "report_text": None,
++            "status": None,
++            "info": info,
++            "delay": _RESTART_DELAY,
++            "consecutive": self._consecutive,
++        }
++
++        if self._stop_requested or kind == "shutdown":
++            self._log("WATCHDOG shutdown (no report, no restart)")
++            return summary
++
++        # اگر ربات مدتِ خوبی سالم کار کرده، خرابیِ بعدی را از نو بشمار.
++        if uptime >= _STABLE_UPTIME:
++            self._consecutive = 0
++
++        if report_worthy:
++            # شمارندهٔ خرابی‌های پشت‌سرهم؛ اگر ربات به‌قدر کافی پایدار کار
++            # کرده بود، شمارنده از قبل صفر شده است.
++            self._consecutive += 1
++            summary["consecutive"] = self._consecutive
++            in_crash_loop = self._consecutive >= _MAX_CRASHES
++            status = (
++                "نیاز به بررسی دارد" if in_crash_loop
++                else "ربات دوباره راه‌اندازی شد"
++            )
++            summary["status"] = status
++            report_text = build_report(info, status)
++            summary["report_text"] = report_text
++
++            write_crash_report(report_text, info, output)
++
++            owner = get_owner()
++            owner_id = int(owner.get("user_id", 0))
++            summary["recipient"] = owner_id
++            now = time.monotonic()
++            if (
++                self._last_report_at is None
++                or now - self._last_report_at >= _REPORT_COOLDOWN
++            ):
++                try:
++                    summary["report_sent"] = bool(self.notifier(owner_id, report_text))
++                except Exception as error:
++                    self._log(f"WATCHDOG notifier failed: {error!r}")
++                self._last_report_at = now
++            else:
++                self._log(
++                    "WATCHDOG report cooldown active; report saved to logs only"
++                )
++            self._log(
++                f"WATCHDOG {kind} file={info.get('file')} "
++                f"line={info.get('line')} error={info.get('error_type')} "
++                f"status={status} consecutive={self._consecutive}"
++            )
++
++            # تأخیرِ نمایی برای جلوگیری از حلقهٔ crash و اسپم.
++            backoff = min(
++                _RESTART_DELAY * (2 ** min(self._consecutive, 6)),
++                _BACKOFF_MAX,
++            )
++            summary["delay"] = backoff
++        else:
++            self._consecutive = 0
++            summary["consecutive"] = 0
++            summary["delay"] = _RESTART_DELAY
++            self._log(f"WATCHDOG {kind} (uptime={uptime:.0f}s) — no report")
++
++        return summary
++
++    def _sleep_interruptible(self, seconds: float) -> None:
++        deadline = time.monotonic() + seconds
++        while not self._stop_requested:
++            remaining = deadline - time.monotonic()
++            if remaining <= 0:
++                return
++            time.sleep(min(1.0, remaining))
++
++    def run(self) -> int:
++        self._install_signals()
++        self._log(
++            f"WATCHDOG ready owner_id={get_owner().get('user_id')} "
++            f"cooldown={_REPORT_COOLDOWN:.0f}s max_crashes={_MAX_CRASHES}"
++        )
++        try:
++            while True:
++                summary = self.run_once()
++                if self._stop_requested or summary["kind"] == "shutdown":
++                    break
++                self._sleep_interruptible(summary.get("delay", _RESTART_DELAY))
++        except KeyboardInterrupt:
++            self._stop_requested = True
++            self._terminate_current()
++        finally:
++            self._child_log.close()
++            self._own_log.close()
++            self._log("WATCHDOG stopped")
++        return 0
++
++
