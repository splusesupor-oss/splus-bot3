+# ---------------------------------------------------------------------------
+_MIN_UPTIME_NORMAL = float(os.environ.get("WATCHDOG_MIN_UPTIME", "60"))
+_STABLE_UPTIME = float(os.environ.get("WATCHDOG_STABLE_UPTIME", "300"))
+_REPORT_COOLDOWN = float(os.environ.get("WATCHDOG_REPORT_COOLDOWN", "900"))
+_MAX_CRASHES = int(os.environ.get("WATCHDOG_MAX_CRASHES", "3"))
+_RESTART_DELAY = float(os.environ.get("WATCHDOG_RESTART_DELAY", "5"))
+_BACKOFF_MAX = float(os.environ.get("WATCHDOG_BACKOFF_MAX", "300"))
+_OUTPUT_LINES = int(os.environ.get("WATCHDOG_OUTPUT_LINES", "3000"))
+_SEND_TIMEOUT = float(os.environ.get("WATCHDOG_SEND_TIMEOUT", "30"))
+_CRASH_REPORT_KEEP = int(os.environ.get("WATCHDOG_CRASH_REPORT_KEEP", "100"))
