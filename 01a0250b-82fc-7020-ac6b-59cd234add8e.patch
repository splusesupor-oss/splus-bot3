++class _RingBuffer:
++    """بافرِ حلقویِ خطوطِ خروجی فرایند (برای استخراج Traceback بدون رشد بی‌نهایت)."""
++
++    def __init__(self, max_lines: int):
++        self._lines = deque(maxlen=max(100, int(max_lines)))
++
++    def append(self, line: str) -> None:
++        self._lines.append(line)
++
++    def text(self) -> str:
++        return "".join(self._lines)
++
++
++class _RotatingLog:
++    """نوشتنِ محدود (rotating) روی دیسک برای خروجیِ خام فرایند و لاگ ناظر.
++
++    هر write فایل را باز/بسته می‌کند تا هیچ file handle ای باز نماند؛
++    حجم ناظر کم است و این ساده‌ترین راهِ بدون نشت است.
++    """
++
++    def __init__(self, path: Path, max_bytes: int = 2 * 1024 * 1024, backups: int = 2):
++        self.path = Path(path)
++        self.max_bytes = max_bytes
++        self.backups = backups
++        self.path.parent.mkdir(parents=True, exist_ok=True)
++
++    def write(self, text: str) -> None:
++        if not text:
++            return
++        try:
++            with open(self.path, "a", encoding="utf-8", errors="replace") as fh:
++                fh.write(text)
++                fh.flush()
++        except OSError:
++            return
++        self._maybe_rotate()
++
++    def _maybe_rotate(self) -> None:
++        try:
++            if self.path.stat().st_size <= self.max_bytes:
++                return
++        except OSError:
++            return
++        for index in range(self.backups - 1, 0, -1):
++            src = self.path.with_name(f"{self.path.name}.{index}")
++            dst = self.path.with_name(f"{self.path.name}.{index + 1}")
++            if src.exists():
++                try:
++                    src.replace(dst)
++                except OSError:
++                    pass
++        backup = self.path.with_name(f"{self.path.name}.1")
++        if self.path.exists():
++            try:
++                self.path.replace(backup)
++            except OSError:
++                pass
++
++    def close(self) -> None:
++        # فایل فقط هنگام write باز می‌شود؛ چیزی برای بستنِ دائمی نیست.
++        pass
++
++
++def _now_text() -> str:
++    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
