++# ---------------------------------------------------------------------------
++# استخراج Traceback
++# ---------------------------------------------------------------------------
++_FILE_LINE_RE = re.compile(r'^\s*File "([^"]+)", line (\d+), in (.+?)\s*$')
++_ERROR_LINE_RE = re.compile(
++    r'^([A-Za-z_][A-Za-z0-9_.]*(?:\.[A-Za-z_][A-Za-z0-9_.]*)*)(?::\s*(.*))?$'
++)
++
++
++def extract_traceback(output_text: str):
++    """استخراج آخرین Traceback از خروجی فرایند.
++
++    برمی‌گرداند dict شامل ``error_type``، ``file``، ``line``، ``function``،
++    ``summary`` و ``traceback`` (متن کامل)؛ یا ``None`` اگر Traceback نبود.
++    """
++    if not output_text:
++        return None
++    lines = output_text.splitlines()
++    start = None
++    for index in range(len(lines) - 1, -1, -1):
++        if lines[index].lstrip().startswith("Traceback (most recent call last):"):
++            start = index
++            break
++    if start is None:
++        return None
++
++    tb_lines = lines[start:]
++    file_name = line_no = func_name = None
++    error_type = summary = ""
++    for line in tb_lines[1:]:
++        file_match = _FILE_LINE_RE.match(line)
++        if file_match:
++            file_name = file_match.group(1)
++            line_no = file_match.group(2)
++            func_name = file_match.group(3)
++            continue
++        if file_name is None:
++            # خطای بدون «File …» (مثل خطای خود asyncio) — نوع را از هر
++            # خطِ غیرتورفته‌ای که شبیه «Error: …» است می‌خوانیم.
++            error_match = _ERROR_LINE_RE.match(line.strip())
++            if error_match and error_match.group(1).endswith("Error"):
++                error_type = error_match.group(1)
++                summary = (error_match.group(2) or "").strip()
++            continue
++        error_match = _ERROR_LINE_RE.match(line)
++        if error_match and not line.startswith((" ", "\t")):
++            error_type = error_match.group(1)
++            summary = (error_match.group(2) or "").strip()
++            break
++
++    if not error_type:
++        return None
++
++    return {
++        "error_type": error_type,
++        "file": file_name or "نامشخص",
++        "line": line_no or "—",
++        "function": func_name or "نامشخص",
++        "summary": summary,
++        "traceback": "\n".join(tb_lines),
++    }
++
++
++def _signal_name(code: int) -> str:
++    if code >= 0:
++        return str(code)
++    try:
++        return f"{signal.Signals(-code).name} ({code})"
++    except (ValueError, AttributeError):
++        return str(code)
++
++
++def classify_exit(code: int, output_text: str, uptime_s: float,
++                  shutdown_requested: bool) -> dict:
++    """تشخیص اینکه پایانِ فرایند یک Crash / توقف غیرعادی / توقف عادی است.
++
++    فقط مواردِ قابل‌گزارش ``report=True`` می‌شوند؛ توقفِ عادی و خاموشیِ
++    عمدی گزارش نمی‌شوند تا مالک اسپم نگیرد.
++    """
++    if shutdown_requested:
++        return {"kind": "shutdown", "report": False, "info": {}}
++
++    traceback_info = extract_traceback(output_text)
++    if traceback_info is not None:
++        return {
++            "kind": "crash",
++            "report": True,
++            "info": traceback_info,
++        }
++
++    if code != 0:
++        return {
++            "kind": "abnormal_stop",
++            "report": True,
++            "info": {
++                "error_type": f"ExitCode({_signal_name(code)})",
++                "file": "نامشخص",
++                "line": "—",
++                "function": "نامشخص",
++                "summary": (
++                    "فرایند ربات بدون Traceback و با کد خطا متوقف شد "
++                    f"(کد {code})."
++                ),
++                "traceback": "",
++            },
++        }
++
++    # خروجِ تمیز (کد ۰) ولی خیلی زودتر از حد انتظار — توقفِ غیرعادی است.
++    if uptime_s < _MIN_UPTIME_NORMAL:
++        return {
++            "kind": "early_stop",
++            "report": True,
++            "info": {
++                "error_type": "NormalExit(early)",
++                "file": "نامشخص",
++                "line": "—",
++                "function": "نامشخص",
++                "summary": (
++                    f"ربات بدون خطا ولی تنها پس از {uptime_s:.0f} ثانیه "
++                    "متوقف شد (توقف زودهنگام)."
++                ),
++                "traceback": "",
++            },
++        }
++
++    return {"kind": "normal_stop", "report": False, "info": {}}
++
++
++# ---------------------------------------------------------------------------
++# قالب گزارش
++# ---------------------------------------------------------------------------
++def build_report(info: dict, status: str, timestamp: str | None = None) -> str:
++    """ساخت متن گزارش مطابق قالب تعیین‌شده برای پیوی مالک."""
++    when = timestamp or _now_text()
++    lines = [
++        "🚨 خطای ربات",
++        "",
++        "زمان:",
++        when,
++        "",
++        "نوع خطا:",
++        str(info.get("error_type") or "نامشخص"),
++        "",
++        "فایل:",
++        str(info.get("file") or "نامشخص"),
++        "",
++        "خط:",
++        str(info.get("line") or "—"),
++        "",
++        "جزئیات:",
++        str(info.get("summary") or "بدون جزئیات"),
++        "",
++        "وضعیت:",
++        status,
++    ]
++    return "\n".join(lines)
++
++
++# ---------------------------------------------------------------------------
++# ارسال گزارش فقط به مالک
++# ---------------------------------------------------------------------------
++async def _send_via_splusthon(owner_id: int, text: str,
++                              timeout: float = _SEND_TIMEOUT):
++    """ارسال پیام خصوصی به مالک با همان کتابخانهٔ ربات (SPlusthon).
++
++    هدف فقط ``owner_id`` (شناسهٔ کاربری مالک) است؛ هیچ گروه یا کاربر
++    دیگری در کار نیست. از همان ``SOROUSH_SESSION_STRING`` و تنظیمات ``.env``
++    استفاده می‌شود.
++    """
++    try:
++        from splusthon import SoroushClient
++        from splusthon.sessions import StringSession
++    except Exception as error:  # pragma: no cover - بستگی به محیط نصب دارد
++        return False, f"splusthon import failed: {error!r}"
++
++    session_str = os.getenv("SOROUSH_SESSION_STRING", "").strip()
++    if not session_str:
++        return False, "SOROUSH_SESSION_STRING not set"
++
++    client = None
++    try:
++        api_id = os.getenv("API_ID", "").strip()
++        api_hash = os.getenv("API_HASH", "").strip()
++        session = StringSession(session_str)
++        if api_id and api_hash:
++            client = SoroushClient(session, int(api_id), api_hash)
++        else:
++            client = SoroushClient(session)
++
++        await asyncio.wait_for(client.connect(), timeout=timeout)
++        # پیوی مالک = ارسال به شناسهٔ عددیِ کاربرِ مالک.
++        await asyncio.wait_for(
++            client.send_message(int(owner_id), text), timeout=timeout
++        )
++        return True, ""
++    except Exception as error:
++        return False, repr(error)
++    finally:
++        if client is not None:
++            try:
++                await asyncio.wait_for(client.disconnect(), timeout=5)
++            except Exception:
++                pass
++
++
++def default_notifier(owner_id: int, text: str) -> bool:
++    """نسخهٔ همگامِ ارسال برای حلقهٔ ناظر (یک event loop جدا در هر ارسال)."""
++    ok, reason = asyncio.run(_send_via_splusthon(owner_id, text))
++    if not ok:
++        print(f"[watchdog] owner report NOT sent: {reason}")
++    return ok
++
